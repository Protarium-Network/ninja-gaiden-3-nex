# Local preservation mode (accounts from settings.json, token not validated).
PN_NG3_LOCAL_MODE=1
PN_NG3_SECURE_HOST=localhost
PN_NG3_KERBEROS_PASSWORD=change-me
# Defaults to 1 (needed by this game). 0 gives 106-0502 on a real console.
# PN_NG3_LEGACY_SIGNATURE=1
# Shared mode (account server): PN_NG3_LOCAL_MODE=0 plus
# PN_NG3_NEX_TOKEN_AES_KEY=<64 hex>   PN_NG3_NEX_PASSWORD_SECRET=<>=32 bytes hex>
# DataStore uploads (replays / clips) need an S3-compatible backend:
# PN_S3_ENDPOINT= PN_S3_ACCESS_KEY= PN_S3_SECRET_KEY= PN_S3_BUCKET=ng3-datastore
